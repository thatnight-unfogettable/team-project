# 统一换行：仓库里一律 LF（.gitattributes 的优先级高于 core.autocrlf）
* text=auto eol=lf

*.js      text eol=lf
*.mjs     text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.csv     text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.svg     text eol=lf

*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制
*.png     binary
*.jpg     binary
*.ico     binary
*.zip     binary

# 生成物：GitHub diff 里标记为 generated，避免一行 882 KB 的"整文件替换"
data/*.js linguist-generated=true
data/shadows.js -diff
data/graph.js -diff
data/basemap.js -diff

# 原始抓取的单行 JSON 不用逐行 diff（但保留可见性）
data/raw/ways.json -diff