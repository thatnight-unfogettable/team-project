root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown 里行尾两个空格是有意义的换行，不要被编辑器吃掉
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[data/*.js]
# 生成物，单行大文件；关掉格式化工具对它的"整理"
insert_final_newline = false

[data/height-report.csv]
# 人工填报用，中文表头 + 直接用 Excel 打开：这里刻意保留 UTF-8 BOM
charset = utf-8-bom